# Credentials for the opt-in real-LLM QA plans.
#
# The regular plans run entirely against the scripted mock LLM and need
# nothing from this file. The real-LLM plans (`pnpm qa:agent --real-llm`)
# run opencode against OpenRouter with a real model, so they need a key:
#
#   cp qa/.env.example qa/.env
#   # fill in QA_OPENROUTER_API_KEY below
#   docker compose -f qa/docker-compose.yml up -d
#
# The workspace container reads these values at creation time, so
# recreate it after editing this file. qa/.env is gitignored.

# OpenRouter API key (https://openrouter.ai/keys) used by the real-LLM
# plans. Leave empty to disable them.
QA_OPENROUTER_API_KEY=

# OpenRouter model reference (provider/model) the real-LLM plans run.
# The default tracks the latest DeepSeek Flash release; pin a concrete
# id such as `openrouter/deepseek/deepseek-v4.1-flash` to freeze it.
QA_REAL_LLM_MODEL=openrouter/~deepseek/deepseek-flash-latest
