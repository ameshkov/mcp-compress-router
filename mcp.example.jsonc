{
  // MCP Compress Router example configuration (JSONC — comments allowed).
  // Copy to mcp.jsonc (or mcp.json) and edit. Both are gitignored.
  // Uses ${VAR} expansion against the environment (including .env).
  "mcpServers": {
    // stdio example — command and env via env vars
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_TOKEN": "${GITHUB_PERSONAL_TOKEN}"
      },
      "description": "GitHub API tools for browsing repositories, issues, and pull requests."
    },
    // http example — bearer token via env var
    "my-server": {
      "type": "http",
      "url": "http://localhost:3100/mcp",
      "headers": {
        "Authorization": "Bearer ${MY_SERVER_TOKEN}"
      },
      // Optional per-server timeout overrides in milliseconds: `startup`
      // bounds the discovery phase (spawn, connect, initialize,
      // tools/list, token refresh), `execution` caps each tool call.
      // Omitted keys fall back to the environment variables and the
      // built-in defaults (startup 30000, execution 3600000).
      "timeout": { "startup": 60000, "execution": 7200000 },
      "description": "My custom MCP server for internal project data."
    },
    // OAuth example — dynamic client registration with a client identity
    // the provider allowlists (e.g. Figma). The router registers itself
    // during `login`; for a pre-registered client use oauth.clientId and
    // oauth.clientSecret instead, which skips registration entirely.
    "oauth-server": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "oauth": {
        "clientName": "My Approved Client",
        "clientUri": "https://example.com/app",
        "scope": "mcp:connect"
      },
      "description": "Remote MCP server that only accepts approved OAuth clients."
    },
    // Tool selection example — only these two tools are exposed; all
    // others the server advertises are hidden and hard-rejected by
    // invoke_tool. Glob patterns (*, ?, {a,b}, [abc]) are matched
    // against bare tool names via picomatch.
    "github-filtered": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_TOKEN": "${GITHUB_PERSONAL_TOKEN}"
      },
      "allowedTools": ["list_issues", "get_pull_request"],
      "disabledTools": ["*_delete"],
      "description": "GitHub API tools restricted to issue and pull request reads."
    },
    // Disabled server example — skipped entirely at startup (no spawn,
    // no connection, no discovery). All config is preserved so it can
    // be turned back on with: mcp-compress-router enable archive
    "archive": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-archive"],
      "description": "Archive tools for old releases (currently disabled).",
      "enabled": false
    }
  }
}
