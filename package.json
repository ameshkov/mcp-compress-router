{
  "name": "mcp-compress-router",
  "version": "1.5.2",
  "description": "Compress all connected MCP servers into a single router MCP to save tokens",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-compress-router": "./build/index.js"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.14.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameshkov/mcp-compress-router.git"
  },
  "homepage": "https://github.com/ameshkov/mcp-compress-router#readme",
  "bugs": {
    "url": "https://github.com/ameshkov/mcp-compress-router/issues"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "typecheck": "tsc && tsc --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules build",
    "format:check": "prettier --check --no-error-on-unmatched-pattern --cache . && markdownlint-cli2 .",
    "format:fix": "prettier --write --no-error-on-unmatched-pattern --cache . && markdownlint-cli2 --fix .",
    "lint": "oxlint src && pnpm knip",
    "lint:fix": "oxlint src --fix",
    "knip": "knip --production",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "husky || true"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "copilot",
    "codex",
    "claude",
    "model-context-protocol",
    "router"
  ],
  "author": "Andrey Meshkov <am@adguard.com>",
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/picomatch": "4.0.3",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "jsonc-parser": "3.3.1",
    "picomatch": "4.0.5",
    "zod": "4.4.3"
  }
}
