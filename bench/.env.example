# Benchmark credentials and settings.
#
# Copy this file to bench/.env and fill in the values for the agents you
# want to run. bench/docker-compose.yml passes the whole file into the
# containers, and the per-run harness maps these variables onto each
# agent's native configuration.
#
# Only the selected agent's variables are required: a run fails fast
# with a message naming the missing variable.

# --- Claude Code ---------------------------------------------------------
# Use an API key or a subscription token (or both, key first):
BENCH_CLAUDE_API_KEY=
BENCH_CLAUDE_OAUTH_TOKEN=
# Gateway bearer token, when the endpoint authenticates with one:
BENCH_CLAUDE_AUTH_TOKEN=
# Optional custom endpoint (gateway, proxy, or mock LLM):
BENCH_CLAUDE_BASE_URL=
# Main model id; the [1m] suffix opts into the model's 1M-token context
# window (Claude Code strips the suffix before sending the request).
# Opus 5.5 needs Claude Code 2.1.280 or newer:
BENCH_CLAUDE_MODEL=claude-opus-5-5[1m]
# Optional small/fast model for background calls:
BENCH_CLAUDE_SMALL_MODEL=
# Claude-specific settings pass through to the CLI unchanged. Pin the
# auto-compact trigger to the full 1M window (100000-1000000):
CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000

# --- Codex CLI -----------------------------------------------------------
BENCH_CODEX_API_KEY=
# Custom provider base URL; empty uses the OpenAI endpoint:
BENCH_CODEX_BASE_URL=
BENCH_CODEX_MODEL=gpt-6-sol
# Wire API for a custom BENCH_CODEX_BASE_URL (Codex supports only responses):
BENCH_CODEX_WIRE_API=responses

# --- OpenCode ------------------------------------------------------------
BENCH_OPENCODE_API_KEY=
BENCH_OPENCODE_BASE_URL=https://openrouter.ai/api/v1
# Must be "<provider>/<model>". Built-in providers: anthropic, openai,
# deepseek, openrouter:
BENCH_OPENCODE_MODEL=openrouter/openai/gpt-6-sol
# npm package used when the provider is not built in:
BENCH_OPENCODE_NPM=@ai-sdk/openai-compatible

# --- GitHub Copilot CLI --------------------------------------------------
# Runs in BYOK mode against an OpenAI-compatible endpoint, so no GitHub
# token is needed:
BENCH_COPILOT_API_KEY=
BENCH_COPILOT_BASE_URL=https://openrouter.ai/api/v1
BENCH_COPILOT_MODEL=openai/gpt-6-sol
# Optional wire API for the endpoint (chat is the default; responses is
# also supported):
BENCH_COPILOT_WIRE_API=responses

# --- Harness (optional) --------------------------------------------------
# Agent timeout per run, in milliseconds (default 1800000 = 30 minutes):
BENCH_TIMEOUT_MS=1800000
# Use cached ccusage pricing instead of fetching it:
# BENCH_CCUSAGE_OFFLINE=1
# Where run directories are written inside the container:
# BENCH_RUNS_DIR=/bench/runs
# Alternate task prompt (must be a path inside the container):
# BENCH_PROMPT_FILE=/app/bench/prompts/todo-app.md
